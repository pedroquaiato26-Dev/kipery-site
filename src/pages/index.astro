---
import { Image } from 'astro:assets';
import { ArrowRight, Bot, Check, ChevronDown, Store } from 'lucide';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { appHost, appLinks, legalLinks } from '../lib/app-links';
import {
  capabilities, faqs, heroHighlights, interestFormFields, partnerFormFields, partnerPoints, trustPoints,
} from '../content/landing';
import dashboardPreview from '../assets/dashboard-preview.png';

/*
 * Página institucional — comunica o modelo comercial ("Cliente usa. Revenda vende. Kipery governa.").
 * Não é uma loja: nada é contratado aqui. Toda ação (entrar, cadastrar, preencher um formulário, ler
 * um documento legal) acontece no sistema, por link para as URLs do contrato em src/lib/app-contract.ts.
 */
const nav = [
  { href: '#produto', label: 'Produto' },
  { href: '#capacidades', label: 'Capacidades' },
  { href: '#revendas', label: 'Para Revendas' },
  { href: '#faq', label: 'FAQ' },
];
const year = new Date().getFullYear();
---

<BaseLayout
  title="Kipery — Plataforma SaaS Modular"
  description="CRM, atendimento com IA, agenda, propostas, contratos e financeiro — tudo integrado num único produto."
>
  <header class="fixed inset-x-0 top-0 z-50 border-b border-border/60 bg-white/80 backdrop-blur-xl">
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
      <a href="/" aria-label="Kipery — início"><Logo size={40} /></a>
      <nav class="hidden items-center gap-6 md:flex" aria-label="Seções">
        {nav.map((item) => <a href={item.href} class="text-sm text-ink-muted transition-colors hover:text-ink">{item.label}</a>)}
      </nav>
      <div class="flex items-center gap-2">
        <a href={appLinks.partnerPortal} class="btn btn-ghost btn-sm hidden lg:inline-flex">Portal da Revenda</a>
        <a href={appLinks.login} class="btn btn-ghost btn-sm hidden sm:inline-flex">Entrar</a>
        <a href={appLinks.queroUsar} class="btn btn-accent btn-sm">Quero usar na minha empresa</a>
      </div>
    </div>
  </header>

  <main>
    <section class="relative overflow-hidden pt-14">
      <div class="absolute inset-0 bg-mesh"></div>
      <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-40"></div>
      <div class="absolute top-0 left-1/2 h-[500px] w-[800px] -translate-x-1/2 bg-hero-glow"></div>

      <div class="relative mx-auto max-w-6xl px-6 pt-20 pb-20 text-center md:pt-28">
        <div class="animate-fade-up">
          <span class="badge-primary">Plataforma SaaS Modular · {year}</span>
          <h1 class="mx-auto mt-6 max-w-3xl font-display text-4xl leading-[1.1] font-bold tracking-tight text-ink md:text-6xl">
            Um sistema que <span class="gradient-text">cresce com sua empresa.</span>
          </h1>
          <p class="mx-auto mt-5 max-w-xl text-lg text-ink-muted">
            CRM, atendimento com IA, agenda, propostas, contratos e financeiro — tudo integrado num
            único produto, do jeito que sua empresa precisa usar.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a href={appLinks.queroUsar} class="btn btn-accent btn-lg">
              Quero usar na minha empresa <Icon icon={ArrowRight} />
            </a>
            <a href="#revendas" class="btn btn-outline btn-lg">Quero ser Revendedor</a>
          </div>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs text-ink-muted">
            {heroHighlights.map((t) => <span class="flex items-center gap-1.5"><Icon icon={Check} class="h-3.5 w-3.5 text-success" /> {t}</span>)}
          </div>
        </div>

        <div class="relative mx-auto mt-16 max-w-4xl animate-fade-up">
          <div class="overflow-hidden rounded-2xl border border-border bg-white shadow-elevated">
            <div class="flex items-center gap-2 border-b border-border bg-surface-muted px-4 py-3">
              <div class="h-2.5 w-2.5 rounded-full bg-red-400"></div>
              <div class="h-2.5 w-2.5 rounded-full bg-yellow-400"></div>
              <div class="h-2.5 w-2.5 rounded-full bg-green-400"></div>
              <span class="ml-2 text-xs text-ink-subtle">{appHost}/dashboard</span>
            </div>
            <Image
              src={dashboardPreview}
              alt="Dashboard real da Kipery, com clientes, receitas e agendamentos em tempo real"
              widths={[720, 1440]}
              sizes="(min-width: 896px) 896px, 100vw"
              class="w-full"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <section id="produto" class="py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-2xl">
          <p class="section-label">Como funciona</p>
          <h2 class="mt-2 font-display text-3xl font-bold text-ink">Você usa. A gestão comercial fica com quem cuida de você.</h2>
          <p class="mt-3 text-ink-muted">
            A Kipery é a plataforma que sua empresa usa no dia a dia. A relação comercial — contratação,
            cobrança e suporte comercial — é feita por uma Revenda parceira da sua região ou, quando não
            houver uma, diretamente pela Kipery. Em ambos os casos, o produto que chega até você é
            exatamente o mesmo.
          </p>
        </div>
      </div>
    </section>

    <section id="capacidades" class="border-y border-border bg-surface-muted py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="max-w-xl">
          <p class="section-label">Capacidades</p>
          <h2 class="mt-2 font-display text-3xl font-bold text-ink">Tudo integrado, num único produto</h2>
          <p class="mt-3 text-ink-muted">Nenhuma capacidade abaixo é vendida separadamente — é parte do que você usa todos os dias.</p>
        </div>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {capabilities.map((f) => (
            <div class="group rounded-2xl border border-border bg-white p-6 transition-all hover:border-primary/20 hover:shadow-card">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-light text-primary transition-colors group-hover:bg-primary group-hover:text-white">
                <Icon icon={f.icon} class="h-5 w-5" />
              </div>
              <h3 class="mt-4 font-semibold text-ink">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div>
            <p class="section-label flex items-center gap-1.5"><Icon icon={Bot} class="h-3.5 w-3.5" /> Inteligência Artificial</p>
            <h2 class="mt-2 font-display text-3xl font-bold text-ink">Atendimento automático, disponível 24 horas</h2>
            <p class="mt-4 leading-relaxed text-ink-muted">
              O assistente de atendimento conversa com seus clientes, qualifica leads e transfere para sua
              equipe quando necessário — configurável com sua própria base de conhecimento.
            </p>
            <a href={appLinks.queroUsar} class="btn btn-outline mt-7 inline-flex">
              Quero usar na minha empresa <Icon icon={ArrowRight} />
            </a>
          </div>
          <div class="rounded-2xl border border-border bg-white p-5 shadow-card" aria-hidden="true">
            <div class="flex items-center gap-2 border-b border-border pb-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-linear-to-br from-violet-600 to-indigo-600 text-white"><Icon icon={Bot} /></span>
              <div>
                <p class="text-sm font-semibold text-ink">Assistente Virtual</p>
                <p class="flex items-center gap-1 text-xs text-success"><span class="h-1.5 w-1.5 rounded-full bg-success"></span> Online agora</p>
              </div>
            </div>
            <div class="mt-4 space-y-3">
              <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-surface-muted p-3 text-sm text-ink">Olá! Como posso ajudar você hoje?</div>
              <div class="ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-primary p-3 text-sm text-white">Quero saber mais sobre a plataforma</div>
              <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-surface-muted p-3 text-sm text-ink">Claro! Posso te transferir para um especialista se quiser conversar mais.</div>
            </div>
            <div class="mt-4 flex items-center gap-2 rounded-lg border border-border px-3 py-2 text-sm text-ink-subtle">Digite sua mensagem...</div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16">
      <div class="mx-auto max-w-6xl px-6">
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
          {trustPoints.map(({ icon, text }) => (
            <div class="flex items-center gap-2.5 text-sm text-ink-muted"><Icon icon={icon} class="h-4 w-4 text-primary" /> {text}</div>
          ))}
        </div>
      </div>
    </section>

    <section id="interesse" class="border-t border-border bg-surface-muted py-24">
      <div class="mx-auto max-w-5xl px-6">
        <div class="grid items-start gap-12 lg:grid-cols-2">
          <div>
            <p class="section-label">Quero usar na minha empresa</p>
            <h2 class="mt-2 font-display text-3xl font-bold text-ink">Comece a usar a Kipery</h2>
            <p class="mt-4 leading-relaxed text-ink-muted">
              Deixe seus dados de contato — nossa equipe ou uma Revenda parceira da sua região entra em
              contato para entender sua empresa e dar sequência. Preencher o formulário não cria uma
              conta nem ativa nenhum plano automaticamente.
            </p>
            <p class="mt-6 text-sm text-ink-subtle">
              Já sabe que quer começar agora, direto com a Kipery (sem Revenda no meio)? <a href={appLinks.register} class="font-semibold text-primary hover:underline">Cadastro Kipery Direct</a>.
            </p>
          </div>
          <div class="card shadow-elevated">
            <p class="font-display text-base font-bold text-ink">O formulário pede só o essencial</p>
            <ul class="mt-4 space-y-2.5">
              {interestFormFields.map((item) => <li class="flex items-start gap-2 text-sm text-ink-muted"><Icon icon={Check} class="mt-0.5 h-4 w-4 shrink-0 text-success" /> {item}</li>)}
            </ul>
            <a href={appLinks.queroUsar} class="btn btn-accent mt-6 w-full">Quero usar na minha empresa <Icon icon={ArrowRight} /></a>
          </div>
        </div>
      </div>
    </section>

    <section id="revendas" class="py-24">
      <div class="mx-auto max-w-5xl px-6">
        <div class="grid items-start gap-12 lg:grid-cols-2">
          <div>
            <p class="section-label flex items-center gap-1.5"><Icon icon={Store} class="h-3.5 w-3.5" /> Para Revendas</p>
            <h2 class="mt-2 font-display text-3xl font-bold text-ink">Quero ser Revendedor</h2>
            <p class="mt-4 leading-relaxed text-ink-muted">
              Como Revenda parceira, você vende e cuida da sua própria carteira de clientes na plataforma
              Kipery.
            </p>
            <ul class="mt-5 space-y-2.5">
              {partnerPoints.map((p) => <li class="flex items-start gap-2 text-sm text-ink-muted"><Icon icon={Check} class="mt-0.5 h-4 w-4 shrink-0 text-success" /> {p}</li>)}
            </ul>
            <p class="mt-6 text-sm text-ink-subtle">A candidatura é analisada pela Kipery antes de qualquer acesso ser liberado.</p>
          </div>
          <div class="card shadow-elevated">
            <p class="font-display text-base font-bold text-ink">O que a candidatura pede</p>
            <ul class="mt-4 space-y-2.5">
              {partnerFormFields.map((item) => <li class="flex items-start gap-2 text-sm text-ink-muted"><Icon icon={Check} class="mt-0.5 h-4 w-4 shrink-0 text-success" /> {item}</li>)}
            </ul>
            <a href={appLinks.sejaRevenda} class="btn btn-accent mt-6 w-full">Quero ser Revendedor <Icon icon={ArrowRight} /></a>
            <p class="mt-4 text-center text-xs text-ink-subtle">
              Já é Revenda parceira? <a href={appLinks.partnerPortal} class="font-semibold text-primary hover:underline">Entrar no Portal da Revenda</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="border-t border-border bg-surface-muted py-24">
      <div class="mx-auto max-w-2xl px-6">
        <h2 class="text-center font-display text-2xl font-bold text-ink">Perguntas frequentes</h2>
        <div class="mt-8 space-y-3">
          {faqs.map((f) => (
            <details class="group rounded-xl border border-border bg-white p-4">
              <summary class="flex cursor-pointer list-none items-center justify-between font-medium text-ink">
                {f.q}
                <Icon icon={ChevronDown} class="h-4 w-4 text-ink-subtle transition-transform group-open:rotate-180" />
              </summary>
              <p class="mt-3 text-sm text-ink-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-20">
      <div class="relative mx-auto max-w-4xl overflow-hidden rounded-3xl bg-slate-900 px-8 py-16 text-center shadow-elevated">
        <div class="absolute inset-0 bg-hero-glow opacity-60"></div>
        <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-[0.12]"></div>
        <div class="relative">
          <h2 class="font-display text-3xl font-bold text-white md:text-4xl">Pronto para começar?</h2>
          <p class="mt-3 text-white/60">Conte pra gente sobre sua empresa e nossa equipe cuida do resto.</p>
          <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
            <a href={appLinks.queroUsar} class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-ink shadow-xs transition-all hover:bg-white/90 active:scale-[0.98]">
              Quero usar na minha empresa <Icon icon={ArrowRight} />
            </a>
            <a href={appLinks.login} class="inline-flex items-center gap-2 rounded-lg border border-white/20 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-white/10">
              Já tenho conta
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-border bg-slate-900 py-12 text-white">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-6 md:flex-row">
      <Logo size={36} tone="light" />
      <div class="flex flex-col items-center gap-2 md:items-start">
        <p class="text-sm text-white/50">© {year} Kipery — Plataforma SaaS</p>
        <nav aria-label="Documentos legais" class="flex flex-wrap justify-center gap-x-3 gap-y-1 text-xs text-white/40 md:justify-start">
          {legalLinks.map((l) => <a href={l.href} class="hover:text-white">{l.label}</a>)}
        </nav>
      </div>
      <div class="flex gap-4 text-sm text-white/50">
        <a href={appLinks.partnerPortal} class="hover:text-white">Portal da Revenda</a>
        <a href={appLinks.login} class="hover:text-white">Entrar</a>
        <a href={appLinks.register} class="hover:text-white">Kipery Direct</a>
      </div>
    </div>
  </footer>
</BaseLayout>
