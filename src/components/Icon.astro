---
import type { IconNode } from 'lucide';

/*
 * Ícones Lucide renderizados como SVG no build: nenhum JavaScript vai para o navegador. Recebe o
 * "nó" do ícone (ex.: `import { Check } from 'lucide'`) e repassa o tamanho/cor via `class`.
 */
interface Props {
  icon: IconNode;
  class?: string;
}

const { icon, class: className = 'h-4 w-4' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {icon.map(([Tag, attrs]) => <Tag {...attrs} />)}
</svg>
